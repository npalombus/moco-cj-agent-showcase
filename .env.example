# Copy this file to ~/.config/moco-cj-agent/.env (or point MOCO_ENV_FILE at your copy) and
# fill in your own values. Never commit the filled-in file: it holds your keys.
# Lines starting with # are ignored. A value in the shell's environment wins over this file.

# --- The model service: "anthropic" or "nvidia" (the default) ---
MOCO_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional backup service, used when the first one fails (set both or neither)
# MOCO_BACKUP_PROVIDER=nvidia
# MOCO_BACKUP_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Slack (only for `serve`; see slack-manifest.yaml) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your workspace id and the member ids allowed to use the agent (comma-separated)
SLACK_ALLOWED_TEAM_ID=
SLACK_ALLOWED_USER_IDS=
# SLACK_ALLOWED_CHANNEL_IDS=

# --- Which data: "synthetic" (made up, the default) or "county" (Montgomery County open data) ---
MOCO_DATA=synthetic
# MOCO_REFRESH_HOURS=24

# --- Conversation ---
MOCO_TALK=on
MOCO_BACKGROUND=on

# --- Rates per resident (county mode, `fetch-census` only; free key from the Census Bureau) ---
# CENSUS_API_KEY=
